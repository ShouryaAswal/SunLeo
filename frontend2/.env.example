# Firebase Auth (get from Firebase Console → Project Settings → General → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend Service URLs (defaults work for local dev — change for Docker/production)
VITE_API_GATEWAY_URL=http://localhost:8000
VITE_RECOMMENDATION_API_URL=http://localhost:8001
VITE_CHATBOT_API_URL=http://localhost:8002

# EmailJS (for the Feedback form — get from https://www.emailjs.com/)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
