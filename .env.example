# App
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Conversion
DOWNLOAD_DIR=backend/ytconverter/downloads
FFMPEG_PATH=

# Optional: YouTube Data API
YOUTUBE_API_KEY=

# Optional: Auth
JWT_SECRET=
JWT_ALGORITHM=HS256

# Firebase Auth (get these from Firebase Console → Project Settings)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Backend Service URLs (for local development)
API_GATEWAY_URL=http://127.0.0.1:8000
RECOMMENDATION_API_URL=http://localhost:8001

# Last.fm API (free — get key at https://www.last.fm/api/account/create)
LASTFM_API_KEY=

# Feedback via EmailJS (free — https://www.emailjs.com/)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Feedback Notifications (Discord Webhook URL — optional)
DISCORD_WEBHOOK_URL=

# Chatbot (Groq free tier — https://console.groq.com/)
GROQ_API_KEY=

# Firestore (Firebase Console → Service Accounts → Generate Key)
# Set this to the path of your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=

